{{- /* Feeds contain published posts only; utility/about pages are not entries. */ -}}
{{- $pages := where site.RegularPages "Section" "posts" -}}
{{- if not .IsHome }}{{ $pages = where .RegularPages "Section" "posts" }}{{ end -}}
{{- $pages = where $pages "Draft" false -}}
{{- $pages = where $pages "PublishDate" "le" now -}}
{{- $pages = where $pages "Date" "le" now -}}
{{- $pages = $pages.ByDate.Reverse -}}
{{- $limit := site.Config.Services.RSS.Limit -}}
{{- if ge $limit 1 }}{{ $pages = first $limit $pages }}{{ end -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ if .IsHome }}{{ site.Title }}{{ else }}{{ .Title }} · {{ site.Title }}{{ end }}</title>
    <link>{{ .Permalink }}</link>
    <description>{{ site.Params.description | default site.Title }}</description>
    <generator>Hugo</generator>
    <language>{{ site.Language.Locale | default site.Language.Lang }}</language>
    {{ with $pages }}<lastBuildDate>{{ (index . 0).PublishDate.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</lastBuildDate>{{ end }}
    {{ with .OutputFormats.Get "RSS" }}<atom:link href="{{ .Permalink }}" rel="self" type="application/rss+xml"/>{{ end }}
    {{ range $pages }}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .PublishDate.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate>
      <guid>{{ .Permalink }}</guid>
      {{ if .Params.protected }}
      <description>该文章已加密，需访问网站输入密码查看。</description>
      {{ else }}
      <description>{{ .Params.summary | default .Summary | plainify }}</description>
      {{ end }}
    </item>
    {{ end }}
  </channel>
</rss>
