{{- /* ============================================================
 * RSS 2.0 摘要订阅
 *
 * 契约来源：执行说明书 F1（5.1–5.4）。要点：
 *   1. 文章集合与排序统一走 feeds/published-posts.html，
 *      与 /subscribe/ 页面共用同一套筛选逻辑，避免两处漂移。
 *   2. 摘要走 feeds/item-description.html：候选顺序 + 240 码点预算 + 双层编码。
 *   3. pubDate 取 .PublishDate（不用 Lastmod / 构建时间）。
 *   4. guid 取 .Permalink，显式 isPermaLink="true"，不随内容变化。
 *   5. lastBuildDate 反映「所含文章最近一次有效公开更新」：
 *      item 有效时间 = Lastmod（有效且不早于 PublishDate）否则 PublishDate，
 *      取最大值；可选 params.rss.updated（固定 RFC3339 文本）参与取最大。
 *   6. 保留 XML 声明与 RSS 2.0 / Atom self 命名空间；self 指向当前 feed。
 *   7. 不引入 XSLT，不添加 xml-stylesheet 处理指令。
 *
 * 诊断：lastmod 为未来、无法解析、时区丢失时，该值被排除并记入 .Store 供
 * 测试与报告读取（见 feeds/effective-time.html）。
 * ============================================================ */ -}}
{{- $pages := site.RegularPages -}}
{{- if not .IsHome -}}{{- $pages = .RegularPages -}}{{- end -}}
{{- $limit := site.Config.Services.RSS.Limit -}}
{{- $pages = partial "feeds/published-posts.html" (dict "pages" $pages "limit" $limit) -}}

{{- /* 计算 channel 时间：所有 item 的有效更新时间最大值 */ -}}
{{- $effective := partial "feeds/effective-time.html" (dict "pages" $pages "site" site) -}}

{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ if .IsHome }}{{ site.Title }}{{ else }}{{ .Title }} · {{ site.Title }}{{ end }}</title>
    <link>{{ .Permalink }}</link>
    <description>{{ site.Params.description | default site.Title }}</description>
    <language>{{ site.Language.Locale | default site.Language.Lang }}</language>
    {{- with $effective.lastBuildDate }}
    <lastBuildDate>{{ . }}</lastBuildDate>
    {{- end }}
    {{- with .OutputFormats.Get "RSS" }}
    <atom:link href="{{ .Permalink }}" rel="self" type="application/rss+xml"/>
    {{- end }}
    {{- /* 诊断必须用 XML 元素承载，不能用 HTML 注释。
          实测：Hugo 的 RSS 输出格式会**剥离 HTML 注释**，
          所以早期 `<!-- feed-diagnostics: ... -->` 实际上从未出现在产物里，
          等于"诊断静默失效"。用户独立复核（2026-10-29 第 6 条）正是发现了这点。
          也不引入自定义命名空间：RSS 2.0 对未知扩展元素宽容，但保守起见
          用 <generator> 承载——它是规范定义的 channel 元素，任何阅读器都接受。
          格式固定为 `Hugo` 或 `Hugo; diagnostics=<内容>`，便于机器判定。 */}}
    {{- with $effective.diagnostics }}
    <generator>Hugo; diagnostics={{ . }}</generator>
    {{- else }}
    <generator>Hugo</generator>
    {{- end }}
    {{- range $pages }}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .PublishDate.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate>
      <guid isPermaLink="true">{{ .Permalink }}</guid>
      {{- /* 标签作 category，保留展示名，同一 item 内去重 */ -}}
      {{- $seen := slice -}}
      {{- range .Params.tags -}}
        {{- $name := . -}}
        {{- if not (in $seen $name) -}}
          {{- $seen = $seen | append $name }}
      <category>{{ $name }}</category>
        {{- end -}}
      {{- end }}
      {{- /* 两层编码：
             纯文本 --htmlEscape(第一层)--> HTML 安全文本
                    --Hugo 自动 XML 转义(第二层)--> 可解析 XML
             绝不能加 safeHTML：那会跳过 XML 层，让 <script> 在阅读器里变可执行。
             （本仓库实测：safeHTML 会与未转义插值输出完全一致，失去双层保护） */}}
      <description>{{ partial "feeds/item-description.html" (dict "page" .) }}</description>
    </item>
    {{- end }}
  </channel>
</rss>
